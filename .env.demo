MONGODB_HOST=mongodb
MONGODB_PORT=27017
# Ejemplo de configuración para .env

# Dirección del contenedor objetivo
TARGET_CONTAINER_HOST=python-api

# Puerto del contenedor objetivo
TARGET_CONTAINER_PORT=8000

# Intervalo de monitoreo en segundos
CHECK_INTERVAL=5

# Zona horaria para el contenedor de monitoreo
TZ=America/Bogota
